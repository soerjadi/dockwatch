# Dockwatch Environment Configuration Example

# Server Address (Default: :3010)
DOCKWATCH_ADDR=:3010

# Docker Host (Default: Unix socket)
DOCKWATCH_DOCKER_HOST=

# Log Level (debug, info, warn, error)
DOCKWATCH_LOG_LEVEL=info

# Database and History Storage Paths
DOCKWATCH_HISTORY_DB=./data/dockwatch.db
DOCKWATCH_HISTORY_DIR=./data/history

# Security Webhook Secret
DOCKWATCH_WEBHOOK_SECRET=your_secure_webhook_secret

# Registry Credentials
DOCKWATCH_GHCR_TOKEN=
GITHUB_TOKEN=
DOCKWATCH_DOCKERHUB_USERNAME=
DOCKWATCH_DOCKERHUB_PASSWORD=
DOCKWATCH_REGISTRY_USERNAME=
DOCKWATCH_REGISTRY_PASSWORD=
